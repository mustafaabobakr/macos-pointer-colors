# Copy to mac/.env.local (dev builds) and mac/.env.prod (releases); both are git-ignored.
# build-app.sh loads .env.local; make-dmg.sh loads .env.prod.

# local: the menu shows "Local build" with the commit and build time.
# release: a build for GitHub; .env.prod must say release, or make-dmg.sh stops.
BUILD_CHANNEL=local
